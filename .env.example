# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/university_doc_intel
# For local fallback/testing without postgres:
# DATABASE_URL=sqlite:///./local_doc_intel.db

# Storage & Vector Paths
CHROMA_PATH=./chroma_db
STORAGE_PATH=./storage

# Authentication
JWT_SECRET=super-secret-development-jwt-key-replace-in-production-12345
JWT_EXPIRE_MINUTES=30
ARGON2_MIN_PASSWORD_LENGTH=10

# LLM Configuration (gemini, openai, fake)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=500

# Embeddings & Retrieval Parameters
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_TOKENS=600
CHUNK_OVERLAP=80
TOP_K_VECTOR=20
TOP_K_KEYWORD=20
TOP_K_FINAL=8
MIN_EVIDENCE_SCORE=0.015

# Upload & Ingestion
MAX_UPLOAD_MB=25

# CORS & Server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
HOST=0.0.0.0
PORT=8000
